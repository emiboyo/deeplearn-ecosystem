{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deeplearn.example/contracts/v1/tool-result.schema.json",
  "title": "DeepLearn ToolResult v1",
  "description": "Core Tool Registry-owned result from one registered tool invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_request_id", "execution_id", "tool_id", "tool_version", "status", "correlation_id", "timing"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "tool_request_id": { "$ref": "#/$defs/id" },
    "execution_id": { "$ref": "#/$defs/id" },
    "tool_id": { "$ref": "#/$defs/name" },
    "tool_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["succeeded", "failed", "timed_out", "denied"] },
    "result": { "type": "object" },
    "failure": { "$ref": "error.schema.json" },
    "evidence_reference": { "type": "string", "minLength": 3 },
    "correlation_id": { "$ref": "#/$defs/id" },
    "trace_id": { "$ref": "#/$defs/id" },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "duration_ms"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "oneOf": [
    { "required": ["result"], "not": { "required": ["failure"] } },
    { "required": ["failure"], "not": { "required": ["result"] } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$" }
  }
}
