{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deeplearn.example/contracts/v1/model-result.schema.json",
  "title": "DeepLearn ModelResult v1",
  "description": "Model Router-owned normalized result without provider-specific response objects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "provider_id", "model_id", "model_version", "latency_ms", "usage", "correlation_id"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["succeeded", "failed"] },
    "output": { "type": "string" },
    "provider_id": { "type": ["string", "null"], "minLength": 3 },
    "model_id": { "type": ["string", "null"], "minLength": 3 },
    "model_version": { "type": ["string", "null"] },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_units", "output_units", "total_units"],
      "properties": {
        "input_units": { "type": "integer", "minimum": 0 },
        "output_units": { "type": "integer", "minimum": 0 },
        "total_units": { "type": "integer", "minimum": 0 }
      }
    },
    "correlation_id": { "$ref": "#/$defs/id" },
    "trace_id": { "$ref": "#/$defs/id" },
    "failure": { "$ref": "model-error.schema.json" }
  },
  "oneOf": [
    { "required": ["output"], "not": { "required": ["failure"] } },
    { "required": ["failure"], "not": { "required": ["output"] } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 8, "maxLength": 128 }
  }
}
