{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deeplearn.example/contracts/v1/tool-definition.schema.json",
  "title": "DeepLearn ToolDefinition v1",
  "description": "Tool Registry-owned immutable declarative metadata. Registration grants no permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_id", "version", "owner", "purpose", "lifecycle", "input_contract_ref", "output_contract_ref", "required_scopes", "allowed_purposes", "risk", "side_effect", "timeout_ms", "max_input_chars", "max_output_chars", "idempotent", "consequential", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "tool_id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semantic_version" },
    "owner": { "$ref": "#/$defs/identifier" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 512 },
    "lifecycle": { "enum": ["draft", "active", "deprecated", "retired"] },
    "input_contract_ref": { "$ref": "#/$defs/contract_reference" },
    "output_contract_ref": { "$ref": "#/$defs/contract_reference" },
    "required_scopes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "allowed_purposes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "risk": { "enum": ["low"] },
    "side_effect": { "enum": ["none"] },
    "timeout_ms": { "type": "integer", "minimum": 1 },
    "max_input_chars": { "type": "integer", "minimum": 1 },
    "max_output_chars": { "type": "integer", "minimum": 1 },
    "idempotent": { "const": true },
    "consequential": { "const": false },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$" },
    "semantic_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "contract_reference": { "type": "string", "pattern": "^contracts/v[1-9][0-9]*/[a-z0-9_./-]+\\.schema\\.json$" }
  }
}
